# AI / LLM
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# n8n
N8N_HOST=your-n8n-host
N8N_WEBHOOK_BASE_URL=https://your-n8n-host/webhook
